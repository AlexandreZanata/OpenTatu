# Copy to `.env` (never commit `.env`). The binary loads it from the current directory.
# Variables already set in the environment win over this file.

# LLM provider key (spec §D.2, R16). Read only by apps/opentatu/src/config.rs; never
# logged, stored in events or reports, or passed to scanners.
OPENCODE_GO_API_KEY=

# Owner's name used in prompts (Q-009). Personal: keep it in .env only.
OPENTATU_OWNER=

# Models, provider and budgets file (spec §D.2).
OPENTATU_MODELS_CONFIG=config/models.toml

# Scanner images, versions and rulesets (ADR-0023).
OPENTATU_SCANNERS_CONFIG=config/scanners.toml

# Data directory: SQLite database and per-app artifacts (spec §B.4).
OPENTATU_DATA_DIR=./data

# Dashboard address. Loopback only (docs/SECURITY.md).
OPENTATU_DASHBOARD_ADDR=127.0.0.1:7878

# Log filter (tracing targets syntax), e.g. `info` or `warn,opentatu_dashboard=debug`.
OPENTATU_LOG=info
